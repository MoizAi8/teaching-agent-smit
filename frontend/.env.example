# Copy to .env.development.local for local development. Never commit populated values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Dedicated PostgreSQL connection required on Vercel. Local development uses isolated SQLite when empty.
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=100
